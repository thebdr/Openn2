obj/
bin/
.vs/

# Siemens-proprietary compile reference (see lib/README.md)
lib/*.dll
lib/*.xml
lib/*.pdb

# Excel workbooks are huge binaries - only the text pipeline (4_PowerQuery) is versioned
Excel Resources/**/*.xlsm
Excel Resources/**/*.xlsx
Excel Resources/4_PowerQuery/Input/
Excel Resources/4_PowerQuery/Output/
Excel Resources/4_PowerQuery/TestInput/
Excel Resources/4_PowerQuery/stage.log
# tiny empty seed needed because SaveCopyAs is the only working save path
!Excel Resources/4_PowerQuery/Templates/Seed.xlsm
# Python bytecode
__pycache__/
*.pyc
# Python DatabaseTool: generated outputs are disposable
Excel Resources/DatabaseTool/Output/
# but the hand-authored interface template IS versioned source
!Excel Resources/DatabaseTool/Templates/
!Excel Resources/DatabaseTool/Templates/*.xlsx

# Editor
.vscode/
