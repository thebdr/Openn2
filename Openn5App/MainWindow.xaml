<Window x:Class="Openn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:local="clr-namespace:Openn"
        mc:Ignorable="d"

        Title="Openn5"

        MinHeight="640"
        Height="820"

        MinWidth="900"
        Width="1150"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Activated="Window_Activated"
        Background="#F4F4F6"
        >
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4,4,4,6"/>
            <Setter Property="Padding" Value="8,6,8,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,4,2"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- shared widths so action/browse buttons line up into clean columns -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="75"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <!-- Workspace tab: group headers of the catalog grid (level 0 = PLC / workspace, 1 = TIA folder, 2 = block group) -->
        <Style x:Key="WorkspaceGroupLevel0" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" BorderThickness="0" Margin="0,3,0,0">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#FF1F4E79"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" FontSize="11" Foreground="#FF808080" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter/>
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceGroupLevel1" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" BorderThickness="0" Margin="0,1,0,0">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#FF333333"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" FontSize="11" Foreground="#FF808080" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter/>
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceGroupLevel2" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Margin="28,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontStyle="Italic" FontSize="11" Foreground="#FF555555"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" FontSize="11" Foreground="#FF808080" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter/>
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5*" MinHeight="260"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4*" MinHeight="140"/>
        </Grid.RowDefinitions>

        <!-- ==================== TIA Project (common to all tabs) ==================== -->
        <GroupBox Grid.Row="0" Header="TIA Project">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- toggle: Attach Project / Detach Project (steelblue when attached) -->
                <Button x:Name="btnAttachProject" Click="btnAttachProject_Click" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="2,2,8,2" MinWidth="130" FontWeight="SemiBold" Content="Attach Project"/>

                <Label Grid.Row="0" Grid.Column="1" Content="Attached project:" Margin="2,0,2,4"/>
                <TextBox x:Name="tbAttachedProject" Grid.Row="1" Grid.Column="1" Margin="2,0,8,2" IsReadOnly="True" Background="#E9E9EC"/>

                <RadioButton x:Name="rbUsePath" GroupName="rbgProjectSource" Grid.Row="0" Grid.Column="2" Margin="2,2,8,4">Attach by path</RadioButton>
                <DockPanel Grid.Row="1" Grid.Column="2" Margin="2,0,8,2">
                    <Button x:Name="btnBrowseProjects" Click="btnBrowseProjects_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                    <TextBox x:Name="tbProjectPath"/>
                </DockPanel>

                <RadioButton x:Name="rbUseInstance" GroupName="rbgProjectSource" Grid.Row="0" Grid.Column="3" Margin="2,2,8,4">Attach to open instance</RadioButton>
                <ComboBox x:Name="cbOpenTiaInstances" Grid.Row="1" Grid.Column="3" Margin="2,0,8,2" Background="White"/>

                <!-- reopen the startup version selection (different version = app restart) -->
                <Button x:Name="btnTiaVersion" Click="btnTiaVersion_Click" Grid.Row="0" Grid.Column="4" VerticalAlignment="Top" Margin="2,0,2,4" Content="TIA Version.." FontSize="10" MinHeight="20" Padding="6,1"/>
            </Grid>
        </GroupBox>

        <!-- ==================== Workspace / Software / Hardware / Project tabs ==================== -->
        <TabControl x:Name="tabMain" Grid.Row="1" Margin="4,2,4,2" SelectedIndex="0" Background="Transparent" BorderThickness="1" BorderBrush="#FFB8B8C0">

            <!-- Workspace (default): the PL5 handoff workspace as a catalog, imports driven by it -->
            <TabItem Header="Workspace">
                <Grid Margin="4,6,4,4" TextElement.FontWeight="Normal" TextElement.FontSize="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- workspace root -->
                    <DockPanel Grid.Row="0" Margin="2,0,2,4">
                        <Label DockPanel.Dock="Left" Content="Workspace root:" VerticalAlignment="Center"/>
                        <Button x:Name="btnWsRescan" Click="btnWsRescan_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" MinWidth="90" Content="Rescan"
                                ToolTip="Classify every file of the workspace again (no TIA needed)"/>
                        <Button x:Name="btnWsDefault" Click="btnWsDefault_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Default"
                                ToolTip="Back to the builtin Shared\OutputTree\TiaPortalProjectInterface\BuilderData (resolved from the exe location)"/>
                        <Button x:Name="btnWsBrowse" Click="btnWsBrowse_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                        <TextBox x:Name="tbWorkspaceRoot" KeyDown="tbWorkspaceRoot_KeyDown"
                                 ToolTip="The handoff workspace Pipeline5 wrote: a project's Output[\&lt;system&gt;]\TiaPortalProjectInterface\BuilderData (VCI shape: &lt;PLC&gt;\Program blocks | PLC tags | PLC data types + Devices &amp; networks + Templates) or the legacy BuilderData folders. Remembered between sessions. Enter = rescan."/>
                    </DockPanel>

                    <!-- summary strip -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#FFB8B8C0" BorderThickness="1" Padding="6,3" Margin="2,0,2,4">
                        <WrapPanel x:Name="wpWorkspaceSummary"/>
                    </Border>

                    <!-- the catalog: PLC > TIA folder > group > file -->
                    <ListView x:Name="lvWorkspace" Grid.Row="2" Margin="2,0,2,0" FontSize="11" SelectionMode="Extended"
                              SelectionChanged="lvWorkspace_SelectionChanged" BorderBrush="#FFB8B8C0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource WorkspaceGroupLevel0}"/>
                            <GroupStyle ContainerStyle="{StaticResource WorkspaceGroupLevel1}"/>
                            <GroupStyle ContainerStyle="{StaticResource WorkspaceGroupLevel2}"/>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Background" Value="{Binding RowBackground}"/>
                                <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                                <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                                <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <EventSetter Event="MouseDoubleClick" Handler="lvWorkspace_RowDoubleClick"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Header="Status" Width="88">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="File" Width="230" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Kind" Width="118" DisplayMemberBinding="{Binding KindId}"/>
                                <GridViewColumn Header="Action" Width="160" DisplayMemberBinding="{Binding Action}"/>
                                <GridViewColumn Header="Producer" Width="140" DisplayMemberBinding="{Binding Producer}"/>
                                <GridViewColumn Header="Generated" Width="118" DisplayMemberBinding="{Binding Generated}"/>
                                <GridViewColumn Header="Run" Width="110" DisplayMemberBinding="{Binding Run}"/>
                                <GridViewColumn Header="Last result" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Result}" Foreground="{Binding ResultBrush}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Notes" Width="340">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NotesText}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Path" Width="340" DisplayMemberBinding="{Binding RelativePath}"/>
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Import selected" Click="btnWsImportSelected_Click"/>
                                <Separator/>
                                <MenuItem Header="Show details in log" Click="miWsLogDetails_Click"/>
                                <MenuItem Header="Open containing folder" Click="miWsOpenFolder_Click"/>
                                <MenuItem Header="Copy full path" Click="miWsCopyPath_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>

                    <!-- detail pane: header, placement, notes of the selected file -->
                    <TextBox x:Name="tbWorkspaceDetail" Grid.Row="3" Height="96" Margin="2,4,2,4" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#FAFAFC" VerticalContentAlignment="Top"/>

                    <!-- actions -->
                    <DockPanel Grid.Row="4" Margin="2,0,2,0">
                        <Button x:Name="btnWsImportAll" Click="btnWsImportAll_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" FontWeight="SemiBold" Content="Import all importable"
                                ToolTip="Every Ready / Legacy / NeedsHeader file, in import order (hardware, UDTs, tag tables, data blocks, instance DBs, block generation, code blocks, sources), per PLC. Invalid / Stale / Unclassified files are skipped with their reason. Nothing is saved."/>
                        <Button x:Name="btnWsImportSelected" Click="btnWsImportSelected_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Import selected"
                                ToolTip="The selected rows (Ctrl / Shift + click), sorted into import order. Non-importable rows are skipped with their reason."/>
                        <Button x:Name="btnWsLogCatalog" Click="btnWsLogCatalog_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" MinWidth="110" Content="Log catalog"
                                ToolTip="Write the catalog summary (counts per kind, files needing attention) to the log"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="rbWsUseExistingControllers" GroupName="rbgWsControllers" Margin="2,0,16,0" Content="Use existing I/O controllers"
                                         ToolTip="Hardware generation attaches to the controllers already in the project (the normal mode)"/>
                            <RadioButton x:Name="rbWsCreateNewControllers" GroupName="rbgWsControllers" Content="Create new I/O controllers"
                                         ToolTip="Hardware generation creates the PLC and its communication modules (fails when they already exist)"/>
                            <TextBlock x:Name="tbWsSelection" Margin="24,0,0,0" Foreground="#666" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Software: the manual, single-file tools -->
            <TabItem Header="Software">
                <GroupBox Header="PLC Program Blocks  (manual, single-file tools)" Margin="4,8,4,4" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search / export -->
                        <DockPanel Grid.Row="0" Margin="2,2,2,8">
                            <Button x:Name="btnExportSource" Click="btnExportSource_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Search / Export Blocks.."/>
                            <Label Content="Browse / export blocks &#8212; regex search over the whole block tree, subfolders included" FontSize="10" Foreground="#666" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Import a single block xml -->
                        <DockPanel Grid.Row="1" Margin="2,0,2,6">
                            <Button x:Name="btnImportSource" Click="btnImportSource_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Import Block"/>
                            <Button x:Name="btnBrowseBlocks" Click="btnBrowseBlocks_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                            <TextBox x:Name="tbSourceBlockPath" ToolTip="Source file (.xml) to import"/>
                        </DockPanel>

                        <!-- Generate blocks from a template csv -->
                        <DockPanel Grid.Row="2" Margin="2,0,2,6">
                            <Button x:Name="btnGenerateBlocks" Click="btnGenerateBlocks_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Generate Blocks"/>
                            <Button x:Name="btnBrowseBlockGenCsv" Click="btnBrowseBlockGenCsv_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                            <TextBox x:Name="tbBlockGenName" DockPanel.Dock="Right" Width="160" Margin="6,0,0,0"
                                     ToolTip="Generated block name. Empty = the template's block name with the TEMPLATE--vX.Y-- prefix stripped."/>
                            <Label DockPanel.Dock="Right" Content="as:" VerticalAlignment="Center"/>
                            <TextBox x:Name="tbBlockGenCsvPath" ToolTip="Generation csv. Row markers in the first cell: $ directive ($,template=&lt;path&gt; / $,separator=;), # comment, % key row, @ data row (@ ; TemplateType ; values...), &amp;END stop. &amp;END as a cell ends the row's columns; # key header = ignored column. Output goes to GeneratedBlocks\ next to the exe."/>
                        </DockPanel>

                        <!-- Create instance DBs directly -->
                        <DockPanel Grid.Row="3" Margin="2,0,2,6">
                            <Button x:Name="btnCreateInstanceDbs" Click="btnCreateInstanceDbs_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Create Instance DBs"/>
                            <Button x:Name="btnBrowseInstanceDbCsv" Click="btnBrowseInstanceDbCsv_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                            <TextBox x:Name="tbInstanceDbCsvPath" ToolTip="Instance DB list csv. % key row names columns: Name, InstanceOf (FB), Number (empty = auto), Folder. @ rows = one instance DB each. Created directly via CreateInstanceDB (no template/XML). Conflicts pop Retry/Abort/Ignore."/>
                        </DockPanel>

                        <!-- Batch import queue -->
                        <DockPanel Grid.Row="4" Margin="2,8,2,2">
                            <Button x:Name="btnRunImportQueue" Click="btnRunImportQueue_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" FontWeight="SemiBold" Content="Run Import Queue"/>
                            <Button x:Name="btnBrowseImportQueue" Click="btnBrowseImportQueue_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                            <TextBox x:Name="tbImportQueuePath" ToolTip="Folder of csv/xml files processed in filename order. Route auto-detected per file (template= csv -> generate+import; Name/InstanceOf csv -> instance DBs; .xml -> import). Subfolders map to TIA block groups. Failures pop Retry/Abort/Ignore."/>
                        </DockPanel>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- Hardware: the manual csv-folder tools -->
            <TabItem Header="Hardware">
                <StackPanel>
                    <GroupBox Header="Hardware Configuration (csv)  (manual tool - the Workspace tab generates from the catalog)" Margin="4,8,4,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Grid.Column="0" Margin="2,2,4,6">
                                <Label DockPanel.Dock="Left" Content="Csv folder:" VerticalAlignment="Center"/>
                                <Button x:Name="btnBrowseHwConfigCsv" Click="btnBrowseHwConfigCsv_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                                <TextBox x:Name="tbHardwareCsvPath" ToolTip="Stations.csv + Modules.csv folder. Follows the scanned workspace's hardware folder until you edit it."/>
                            </DockPanel>
                            <Button x:Name="btnImportHardwareCsv" Click="btnImportHardwareCsv_Click" Grid.Row="0" Grid.Column="1" Style="{StaticResource ActionButton}" Margin="4,2,0,6" Content="Reload Csv Config"/>
                            <Button x:Name="btnEditHardwareConfig" Click="btnEditHardwareConfig_Click" Grid.Row="0" Grid.Column="2" Style="{StaticResource ActionButton}" Margin="4,2,0,6" Content="Edit Hardware Config.."/>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="2,0,4,2" VerticalAlignment="Center">
                                <RadioButton x:Name="rbUseExistingIoControllers" GroupName="rbgIoControllerSource" Margin="0,0,16,0" FontFamily="Consolas">Use Existing I/O Controllers</RadioButton>
                                <RadioButton x:Name="rbCreateNewIoControllers" GroupName="rbgIoControllerSource" FontFamily="Consolas">Create New I/O Controllers</RadioButton>
                            </StackPanel>
                            <Button x:Name="btnGenerateHardware" Click="btnGenerateHardware_Click" Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionButton}" Margin="4,0,0,2" FontWeight="SemiBold" Content="Generate Hardware"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Attribute Discovery" Margin="4,4,4,4">
                        <DockPanel Margin="2,2,2,2">
                            <Button x:Name="btnDumpAttributes" Click="btnDumpAttributes_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Dump Device Attributes"/>
                            <Label DockPanel.Dock="Left" Content="Device filter:" VerticalAlignment="Center"/>
                            <TextBox x:Name="tbDumpDeviceFilter" ToolTip="Dumps device attribute trees + GSD PrmData to AttributeDumps\ (paths in csv syntax). Device name filter: regex, case-insensitive, empty = all devices."/>
                        </DockPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- Project: whole-project round-trip against the builtin Shared tree (fixed legacy folders) -->
            <TabItem Header="Project">
                <StackPanel>
                    <GroupBox Header="Import from Shared  (legacy folder route - the Workspace tab is the catalog-driven way)" Margin="4,8,4,4">
                        <StackPanel>
                            <DockPanel Margin="2,2,2,6">
                                <Button x:Name="btnImportFullProject" Click="btnImportFullProject_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" FontWeight="SemiBold" Content="Import Full Project"/>
                                <Button x:Name="btnScanWorkspace" Click="btnScanWorkspace_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Content="Scan Workspace"
                                        ToolTip="Rescan the Workspace tab's root and write the catalog summary to the log (contract v1 headers, legacy markers as fallback) - no TIA needed"/>
                                <CheckBox x:Name="cbImportCreateNewControllers" IsChecked="True" VerticalAlignment="Center" FontWeight="Normal" Margin="2,0,0,0" Content="Create new I/O controllers (else attach to existing)"/>
                            </DockPanel>
                            <WrapPanel Margin="2,0,2,2">
                                <Button x:Name="btnImportHardware"      Click="btnImportHardware_Click"      Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="1  Hardware"/>
                                <Button x:Name="btnImportUdts"          Click="btnImportUdts_Click"          Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="2  UDTs"/>
                                <Button x:Name="btnImportIoTags"        Click="btnImportIoTags_Click"        Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="3  IO Tags"/>
                                <Button x:Name="btnImportDataBlocks"    Click="btnImportDataBlocks_Click"    Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="4  Data Blocks"/>
                                <Button x:Name="btnImportInstanceDbsProj" Click="btnImportInstanceDbsProj_Click" Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="5  Instance DBs"/>
                                <Button x:Name="btnImportSoftwareBlocks" Click="btnImportSoftwareBlocks_Click" Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="6  Software Blocks"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Export to Shared  (dump the attached project for Pipeline5 validation)" Margin="4,4,4,4">
                        <StackPanel>
                            <DockPanel Margin="2,2,2,6">
                                <Button x:Name="btnExportFullProject" Click="btnExportFullProject_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" FontWeight="SemiBold" Content="Export Full Project"/>
                                <Label Content="Everything as XML; hardware as CAx / AML." FontSize="10" Foreground="#666" VerticalAlignment="Center"/>
                            </DockPanel>
                            <WrapPanel Margin="2,0,2,2">
                                <Button x:Name="btnExportSoftwareBlocks" Click="btnExportSoftwareBlocks_Click" Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="Software Blocks"/>
                                <Button x:Name="btnExportDataBlocks"     Click="btnExportDataBlocks_Click"     Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="Data Blocks"/>
                                <Button x:Name="btnExportUdts"           Click="btnExportUdts_Click"           Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="UDTs"/>
                                <Button x:Name="btnExportTagTables"      Click="btnExportTagTables_Click"      Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="Tag Tables"/>
                                <Button x:Name="btnExportHardwareCax"    Click="btnExportHardwareCax_Click"    Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="Hardware (CAx)"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <Label x:Name="lblSharedRoot" Margin="6,2,6,2" FontSize="10" FontWeight="Normal" Foreground="#888"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- splitter between the tabs and the log -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#FFD8D8DE" Margin="6,1,6,1"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

        <!-- ==================== Log (toolbar + view) ==================== -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="6,2,6,2">
                <Label DockPanel.Dock="Left" Content="Log" FontWeight="SemiBold"/>
                <Button x:Name="btnClearLogs" Click="btnClearLogs_Click" DockPanel.Dock="Right" MinWidth="80" Background="#FFADFFF9" Content="Clear Logs"/>
                <Button x:Name="btnCancelOperation" Click="btnCancelOperation_Click" DockPanel.Dock="Right" Margin="0,0,8,0" MinWidth="120" FontWeight="SemiBold" Background="#FFFFD2D2" Visibility="Hidden" Content="Cancel Operation"/>
                <CheckBox x:Name="cbLogToFile" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="Normal" Content="Log to file" Checked="cbLogToFile_Checked" Unchecked="cbLogToFile_Unchecked"/>
                <TextBox x:Name="tbLogFilter" Margin="8,0,12,0" FontWeight="Normal" TextChanged="tbLogFilter_TextChanged"
                         ToolTip="Filter shown log lines (regex, case-insensitive). Invalid pattern = show all (box turns red)."/>
            </DockPanel>

            <ListView x:Name="lbLogView" x:FieldModifier="public" Grid.Row="1" Margin="4,0,4,4"
                      FontSize="11" FontFamily="Consolas" SelectionMode="Extended"
                      BorderThickness="1" BorderBrush="#FF0015C7"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      KeyDown="lbLogView_KeyDown">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy selected" InputGestureText="Ctrl+C" Click="miCopyLogSelected_Click"/>
                        <MenuItem Header="Copy all" Click="miCopyLogAll_Click"/>
                        <Separator/>
                        <MenuItem Header="Clear" Click="btnClearLogs_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <!-- Method Running Spinner (overlays the log view) -->
            <fa:ImageAwesome x:Name="icoRunning" Panel.ZIndex="2" Visibility="Hidden" Icon="Refresh" Spin="True" Grid.Row="1" Height="48" Width="48" SpinDuration="10" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF0015C7"/>
        </Grid>
    </Grid>

</Window>
