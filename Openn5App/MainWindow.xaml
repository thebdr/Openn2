<Window x:Class="Openn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:local="clr-namespace:Openn"
        mc:Ignorable="d"

        Title="Openn5"

        MinHeight="640"
        Height="820"

        MinWidth="900"
        Width="1150"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Activated="Window_Activated"
        Closing="Window_Closing"
        Background="#F4F4F6"
        >
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4,4,4,6"/>
            <Setter Property="Padding" Value="8,6,8,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,4,2"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- shared widths so action/browse buttons line up into clean columns -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="75"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Workspace tab: the catalog grid's group headers drawn as a tree. Level 0 = PLC / workspace (blue band),
             1 = TIA folder (grey band with a blue left bar, indented), 2 = block group (plain, further indented; the
             "(root)" group draws no header at all). A flat toggle with a triangle glyph - right = collapsed,
             down = expanded - replaces the default Expander chrome, so the state reads at a glance. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="GroupToggle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="6,2,6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF1F4E79"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="&#x25BE;"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FF1F4E79"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                    <Setter Property="Text" Value="&#x25B8;"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkspaceGroupLevel0" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <StackPanel>
                            <ToggleButton x:Name="toggle" IsChecked="True" Style="{StaticResource GroupToggle}" Margin="0,6,0,1"
                                          Background="#FFDCE8F5" BorderBrush="#FF9FB8D8" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GroupGlyph}"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#FF1F4E79"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" FontSize="11" Foreground="#FF5A6B7E" Margin="5,0,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ItemsPresenter Visibility="{Binding IsChecked, ElementName=toggle, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceGroupLevel1" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <StackPanel>
                            <ToggleButton x:Name="toggle" IsChecked="True" Style="{StaticResource GroupToggle}" Margin="18,2,0,1"
                                          Background="#FFF1F3F6" BorderBrush="#FF9FB8D8" BorderThickness="3,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GroupGlyph}"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#FF333333"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" FontSize="11" Foreground="#FF808080" Margin="5,0,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ItemsPresenter Visibility="{Binding IsChecked, ElementName=toggle, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceGroupLevel2" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <StackPanel>
                            <ToggleButton x:Name="toggle" IsChecked="True" Style="{StaticResource GroupToggle}" Margin="36,1,0,0"
                                          Background="Transparent" BorderBrush="#FFC8CDD5" BorderThickness="3,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource GroupGlyph}" Foreground="#FF808080"/>
                                    <TextBlock Text="{Binding Name}" FontStyle="Italic" FontSize="11" Foreground="#FF555555"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat='({0})'}" FontSize="11" Foreground="#FF808080" Margin="5,0,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ItemsPresenter Visibility="{Binding IsChecked, ElementName=toggle, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <!-- files directly in the TIA folder: no third band, they sit right under the folder -->
                            <DataTrigger Binding="{Binding Name}" Value="(root)">
                                <Setter TargetName="toggle" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="rowTabs" Height="*" MinHeight="260"/>
            <RowDefinition Height="Auto"/>
            <!-- the log starts six lines tall (SetDefaultLogHeight measures the real line height at Loaded); the splitter resizes it -->
            <RowDefinition x:Name="rowLog" Height="150" MinHeight="70"/>
        </Grid.RowDefinitions>

        <!-- ==================== TIA project connection: collapsed by default (rarely used) ====================
             The header keeps the Attach/Detach toggle and the attached-project status visible; the body holds the
             instance dropdown, the project path and the TIA version switch. -->
        <Expander x:Name="expProject" Grid.Row="0" Margin="4,0,4,4" IsExpanded="False"
                  Expanded="expProject_Toggled" Collapsed="expProject_Toggled"
                  Background="White" BorderBrush="#FFB8B8C0" BorderThickness="1" Padding="6,3,6,3">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnAttachProject" Click="btnAttachProject_Click" MinWidth="130" FontWeight="SemiBold" Content="Attach Project" Margin="0,0,12,0"
                            ToolTip="Attach = the selected open TIA instance (or the project path, expand to choose); Detach releases the project"/>
                    <TextBlock x:Name="tbProjectStatus" VerticalAlignment="Center" FontWeight="Normal" FontSize="12" Text="TIA project: not attached"/>
                </StackPanel>
            </Expander.Header>
            <Grid Margin="0,6,0,2" TextElement.FontWeight="Normal">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Attached project:" Margin="2,0,2,4"/>
                <TextBox x:Name="tbAttachedProject" Grid.Row="1" Grid.Column="0" Margin="2,0,8,2" IsReadOnly="True" Background="#E9E9EC"/>

                <RadioButton x:Name="rbUseInstance" GroupName="rbgProjectSource" Grid.Row="0" Grid.Column="1" Margin="2,2,8,4">Attach to open instance</RadioButton>
                <ComboBox x:Name="cbOpenTiaInstances" Grid.Row="1" Grid.Column="1" Margin="2,0,8,2" Background="White"/>

                <RadioButton x:Name="rbUsePath" GroupName="rbgProjectSource" Grid.Row="0" Grid.Column="2" Margin="2,2,8,4">Attach by path</RadioButton>
                <DockPanel Grid.Row="1" Grid.Column="2" Margin="2,0,8,2">
                    <Button x:Name="btnBrowseProjects" Click="btnBrowseProjects_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                    <TextBox x:Name="tbProjectPath"/>
                </DockPanel>

                <!-- reopen the startup version selection (different version = app restart) -->
                <Button x:Name="btnTiaVersion" Click="btnTiaVersion_Click" Grid.Row="1" Grid.Column="3" Margin="2,0,2,2" Content="TIA Version.." FontSize="10" MinHeight="20" Padding="6,1" VerticalAlignment="Center"/>
            </Grid>
        </Expander>

        <!-- ==================== Workspace (the focus) | Files (single-file tools) ==================== -->
        <TabControl x:Name="tabMain" Grid.Row="1" Margin="4,2,4,2" SelectedIndex="0" Background="Transparent" BorderThickness="1" BorderBrush="#FFB8B8C0">

            <!-- Workspace: the PL5 handoff workspace as a catalog; import and export driven by it -->
            <TabItem Header="Workspace">
                <Grid Margin="4,6,4,4" TextElement.FontWeight="Normal" TextElement.FontSize="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- workspace root -->
                    <DockPanel Grid.Row="0" Margin="2,0,2,4">
                        <Label DockPanel.Dock="Left" Content="Workspace root:" VerticalAlignment="Center"/>
                        <Button x:Name="btnWsRescan" Click="btnWsRescan_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" MinWidth="90" Content="Rescan"
                                ToolTip="Classify every file of the workspace again (no TIA needed)"/>
                        <Button x:Name="btnWsDefault" Click="btnWsDefault_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Default"
                                ToolTip="Back to the builtin Shared\OutputTree\TiaPortalProjectInterface\BuilderData (resolved from the exe location)"/>
                        <Button x:Name="btnWsBrowse" Click="btnWsBrowse_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                        <TextBox x:Name="tbWorkspaceRoot" KeyDown="tbWorkspaceRoot_KeyDown"
                                 ToolTip="The handoff workspace Pipeline5 wrote: a project's Output[\&lt;system&gt;]\TiaPortalProjectInterface\BuilderData in the VCI shape (&lt;PLC&gt;\Program blocks | PLC tags | PLC data types + Devices &amp; networks + Templates + .openn\workspace.openn.config). Remembered between sessions. Enter = rescan."/>
                    </DockPanel>

                    <!-- summary strip -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#FFB8B8C0" BorderThickness="1" Padding="6,3" Margin="2,0,2,4"
                            ToolTip="Click a chip to show only the rows it counts; click it again to show all">
                        <WrapPanel x:Name="wpWorkspaceSummary"/>
                    </Border>

                    <!-- live text filter (combined with the chip filter) -->
                    <DockPanel Grid.Row="2" Margin="2,0,2,4">
                        <Label DockPanel.Dock="Left" Content="Filter:" VerticalAlignment="Center"/>
                        <Button x:Name="btnWsClearFilter" Click="btnWsClearFilter_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Clear" Visibility="Collapsed"
                                ToolTip="Show all rows again (clears the text filter and the chip filter)"/>
                        <TextBlock x:Name="tbWsFilterInfo" DockPanel.Dock="Right" Margin="8,0,8,0" VerticalAlignment="Center" FontSize="10" Foreground="#666"/>
                        <TextBox x:Name="tbWsFilter" TextChanged="tbWsFilter_TextChanged" KeyDown="tbWsFilter_KeyDown"
                                 ToolTip="Narrows the grid as you type - matches file name, path, kind, status, action, producer, run and notes (regex, case-insensitive; a pattern that is not a valid regex matches as plain text). Esc clears. Combines with a clicked chip."/>
                    </DockPanel>

                    <!-- the catalog: PLC > TIA folder > group > file -->
                    <ListView x:Name="lvWorkspace" Grid.Row="3" Margin="2,0,2,0" FontSize="11" SelectionMode="Extended"
                              SelectionChanged="lvWorkspace_SelectionChanged" BorderBrush="#FFB8B8C0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource WorkspaceGroupLevel0}"/>
                            <GroupStyle ContainerStyle="{StaticResource WorkspaceGroupLevel1}"/>
                            <GroupStyle ContainerStyle="{StaticResource WorkspaceGroupLevel2}"/>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Background" Value="{Binding RowBackground}"/>
                                <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                                <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                                <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <EventSetter Event="MouseDoubleClick" Handler="lvWorkspace_RowDoubleClick"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Width="54">
                                    <GridViewColumn.Header>
                                        <TextBlock Text="Import" ToolTip="Tick = the file takes part in Import Selection / Import Workspace. Untick to keep a file out: remembered per workspace (.openn\import.openn5.config), so it survives rescans, restarts and PL5 regenerations. Right-click selected rows to tick / untick many at once."/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding ImportEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding CanToggleImport, Converter={StaticResource BoolToVis}}" ToolTip="{Binding ImportToggleTip}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Status" Width="88">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="File" Width="230" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Kind" Width="118" DisplayMemberBinding="{Binding KindId}"/>
                                <GridViewColumn Header="Action" Width="160" DisplayMemberBinding="{Binding Action}"/>
                                <GridViewColumn Header="Producer" Width="140" DisplayMemberBinding="{Binding Producer}"/>
                                <GridViewColumn Header="Generated" Width="118" DisplayMemberBinding="{Binding Generated}"/>
                                <GridViewColumn Header="Run" Width="110" DisplayMemberBinding="{Binding Run}"/>
                                <GridViewColumn Header="Last result" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Result}" Foreground="{Binding ResultBrush}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Notes" Width="340">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NotesText}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Path" Width="340" DisplayMemberBinding="{Binding RelativePath}"/>
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Import Selection" Click="btnWsImportSelected_Click"/>
                                <Separator/>
                                <MenuItem Header="Tick Import for selected" Click="miWsEnableImport_Click" ToolTip="The selected importable rows take part in the import again"/>
                                <MenuItem Header="Untick Import for selected" Click="miWsDisableImport_Click" ToolTip="The selected importable rows are kept out of the import (remembered per workspace)"/>
                                <Separator/>
                                <MenuItem Header="Show details in log" Click="miWsLogDetails_Click"/>
                                <MenuItem Header="Open containing folder" Click="miWsOpenFolder_Click"/>
                                <MenuItem Header="Copy full path" Click="miWsCopyPath_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>

                    <!-- detail pane: header, placement, notes of the selected file -->
                    <TextBox x:Name="tbWorkspaceDetail" Grid.Row="4" Height="96" Margin="2,4,2,4" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#FAFAFC" VerticalContentAlignment="Top"/>

                    <!-- import actions -->
                    <DockPanel Grid.Row="5" Margin="2,0,2,0">
                        <Button x:Name="btnWsImportAll" Click="btnWsImportAll_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" FontWeight="SemiBold" Content="Import Workspace"
                                ToolTip="The whole workspace: every Ready, ticked file, in import order (hardware, UDTs, tag tables, data blocks, instance DBs, block generation, code blocks, sources), per PLC. Files without a valid #!openn header, misplaced, stale or unclassified files are skipped with their reason, and so are rows whose Import box is unticked. Nothing is saved."/>
                        <Button x:Name="btnWsImportSelected" Click="btnWsImportSelected_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Import Selection"
                                ToolTip="The selected rows (Ctrl / Shift + click), sorted into import order. Non-importable rows and rows whose Import box is unticked are skipped with their reason."/>
                        <Button x:Name="btnWsLogCatalog" Click="btnWsLogCatalog_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" MinWidth="110" Content="Log catalog"
                                ToolTip="Write the catalog summary (counts per kind, files needing attention) to the log"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="rbWsUseExistingControllers" GroupName="rbgWsControllers" Margin="2,0,16,0" Content="Use existing I/O controllers" Checked="ControllerMode_Checked"
                                         ToolTip="Hardware generation attaches to the controllers already in the project (the normal mode)"/>
                            <RadioButton x:Name="rbWsCreateNewControllers" GroupName="rbgWsControllers" Content="Create new I/O controllers" Checked="ControllerMode_Checked"
                                         ToolTip="Hardware generation creates the PLC and its communication modules (fails when they already exist)"/>
                            <CheckBox x:Name="cbWsWirePorts" Margin="24,0,0,0" VerticalAlignment="Center" Content="Wire PROFINET ports" Checked="WirePorts_Changed" Unchecked="WirePorts_Changed"
                                      ToolTip="After the stations exist, connect the PROFINET ports listed in the Topology column of Stations.csv (X1-P2 &gt; station:X1-P1, | separated): the topology view and the online topology diagnostics then match the plant. Pairs already connected are left alone; a port connected elsewhere is reported, never disconnected. The same choice as on the Files tab (kept in sync); remembered."/>
                            <TextBlock x:Name="tbWsSelection" Margin="24,0,0,0" Foreground="#666" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- export: the attached project into the workspace's sibling ExportedData, same shape, stamped -->
                    <Expander x:Name="expExport" Grid.Row="6" Margin="2,6,2,0" IsExpanded="False" Background="#FAFAFC" BorderBrush="#FFB8B8C0" BorderThickness="1" Padding="6,2,6,4">
                        <Expander.Header>
                            <TextBlock FontSize="12">
                                <Run Text="Export the attached TIA project" FontWeight="SemiBold"/>
                                <Run Text="  &#8594;  "/>
                                <Run x:Name="runExportRoot" Text="(scan a workspace first)" Foreground="#555"/>
                            </TextBlock>
                        </Expander.Header>
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource HintText}" Margin="2,0,2,6"
                                       Text="The same VCI shape as the workspace, beside it: &lt;PLC&gt;\Program blocks | PLC data types | PLC tags as TIA XML with the #!openn header, the hardware as CAx/AML under Devices &amp; networks, and .openn\workspace.openn.config with a fresh run id. The full export sweeps the PLC's folders first; a single export only overwrites same-named files. Nothing in TIA is changed."/>
                            <WrapPanel>
                                <Button x:Name="btnExportFullProject" Click="btnExportFullProject_Click" Style="{StaticResource ActionButton}" Margin="2,2,4,2" FontWeight="SemiBold" Content="Export full project"/>
                                <Button x:Name="btnExportSoftwareBlocks" Click="btnExportSoftwareBlocks_Click" Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="Code blocks"/>
                                <Button x:Name="btnExportDataBlocks"     Click="btnExportDataBlocks_Click"     Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="Data blocks"/>
                                <Button x:Name="btnExportUdts"           Click="btnExportUdts_Click"           Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="UDTs"/>
                                <Button x:Name="btnExportTagTables"      Click="btnExportTagTables_Click"      Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="Tag tables"/>
                                <Button x:Name="btnExportHardwareCax"    Click="btnExportHardwareCax_Click"    Style="{StaticResource ActionButton}" Margin="4,2,4,2" Content="Hardware (CAx)"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </Grid>
            </TabItem>

            <!-- Files: the single-file tools (one block, one csv, one hardware folder, attribute dump) -->
            <TabItem Header="Files">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,6,4,4">
                        <TextBlock Style="{StaticResource HintText}" Margin="6,0,6,6"
                                   Text="Single-file tools. The Workspace tab is the normal way in - it imports whole handoff workspaces by their headers. Use these when you need one block, one csv or one hardware folder by hand."/>

                        <GroupBox Header="Program blocks - one file at a time">
                            <Grid TextElement.FontWeight="Normal">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Search / export -->
                                <DockPanel Grid.Row="0" Margin="2,2,2,8">
                                    <Button x:Name="btnExportSource" Click="btnExportSource_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Search / Export Blocks.."/>
                                    <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Text="Browse the attached project's block tree (regex search, subfolders and UDTs included) and export single blocks as XML or source."/>
                                </DockPanel>

                                <!-- Import a single block file -->
                                <DockPanel Grid.Row="1" Margin="2,0,2,6">
                                    <Button x:Name="btnImportSource" Click="btnImportSource_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Import Block"/>
                                    <Button x:Name="btnBrowseBlocks" Click="btnBrowseBlocks_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                                    <TextBox x:Name="tbSourceBlockPath" ToolTip="One file to import into the attached project's Program blocks root, routed by content: a block XML (overrides a same-named block), a generation csv (template= directive -> generate + import), an instance-DB csv (Name/InstanceOf columns), or a .db/.scl/.awl source (blocks generated; a stale source object is replaced)"/>
                                </DockPanel>

                                <!-- Generate blocks from a template csv -->
                                <DockPanel Grid.Row="2" Margin="2,0,2,6">
                                    <Button x:Name="btnGenerateBlocks" Click="btnGenerateBlocks_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Generate Blocks"/>
                                    <Button x:Name="btnBrowseBlockGenCsv" Click="btnBrowseBlockGenCsv_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                                    <TextBox x:Name="tbBlockGenName" DockPanel.Dock="Right" Width="160" Margin="6,0,0,0"
                                             ToolTip="Generated block name. Empty = the template's block name with the TEMPLATE--vX.Y-- prefix stripped."/>
                                    <Label DockPanel.Dock="Right" Content="as:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="tbBlockGenCsvPath" ToolTip="One block-generation csv (sw/block-gen). Row markers in the first cell: $ directive ($,template=&lt;path&gt; / $,separator=;), # comment, % key row, @ data row, &amp;END stop. The XML goes to GeneratedBlocks\ next to the exe and its path lands in the import box above."/>
                                </DockPanel>

                                <!-- Create instance DBs directly -->
                                <DockPanel Grid.Row="3" Margin="2,0,2,2">
                                    <Button x:Name="btnCreateInstanceDbs" Click="btnCreateInstanceDbs_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Create Instance DBs"/>
                                    <Button x:Name="btnBrowseInstanceDbCsv" Click="btnBrowseInstanceDbCsv_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                                    <TextBox x:Name="tbInstanceDbCsvPath" ToolTip="One instance-DB list csv (sw/instance-db). % key row names the columns: Name, InstanceOf (FB), Number (empty = auto), Folder; @ rows = one instance DB each. Created directly via CreateInstanceDB; conflicts pop Retry/Abort/Ignore."/>
                                </DockPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Hardware configuration - one csv folder">
                            <Grid TextElement.FontWeight="Normal">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Grid.Column="0" Margin="2,2,4,6">
                                    <Label DockPanel.Dock="Left" Content="Csv folder:" VerticalAlignment="Center"/>
                                    <Button x:Name="btnBrowseHwConfigCsv" Click="btnBrowseHwConfigCsv_Click" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}" Content="Browse.."/>
                                    <TextBox x:Name="tbHardwareCsvPath" ToolTip="Folder with Stations.csv + Modules.csv (hw/stations, hw/modules; the #!openn header is required). Follows the scanned workspace's Devices &amp; networks folder until you edit it."/>
                                </DockPanel>
                                <Button x:Name="btnImportHardwareCsv" Click="btnImportHardwareCsv_Click" Grid.Row="0" Grid.Column="1" Style="{StaticResource ActionButton}" Margin="4,2,0,6" Content="Reload Csv Config"/>
                                <Button x:Name="btnEditHardwareConfig" Click="btnEditHardwareConfig_Click" Grid.Row="0" Grid.Column="2" Style="{StaticResource ActionButton}" Margin="4,2,0,6" Content="Edit Hardware Config.."/>

                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="2,0,4,2" VerticalAlignment="Center">
                                    <RadioButton x:Name="rbUseExistingIoControllers" GroupName="rbgIoControllerSource" Margin="0,0,16,0" Content="Use existing I/O controllers" Checked="ControllerMode_Checked"
                                                 ToolTip="The same choice as on the Workspace tab (kept in sync)"/>
                                    <RadioButton x:Name="rbCreateNewIoControllers" GroupName="rbgIoControllerSource" Content="Create new I/O controllers" Checked="ControllerMode_Checked"
                                                 ToolTip="The same choice as on the Workspace tab (kept in sync)"/>
                                    <CheckBox x:Name="cbWirePorts" Margin="24,0,0,0" VerticalAlignment="Center" Content="Wire PROFINET ports" Checked="WirePorts_Changed" Unchecked="WirePorts_Changed"
                                              ToolTip="After the stations exist, connect the PROFINET ports listed in the Topology column of Stations.csv (X1-P2 &gt; station:X1-P1, | separated). The same choice as on the Workspace tab (kept in sync); remembered."/>
                                </StackPanel>
                                <Button x:Name="btnGenerateHardware" Click="btnGenerateHardware_Click" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ActionButton}" Margin="4,0,0,2" FontWeight="SemiBold" Content="Generate Hardware"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Discovery">
                            <DockPanel Margin="2,2,2,2" TextElement.FontWeight="Normal">
                                <Button x:Name="btnDumpAttributes" Click="btnDumpAttributes_Click" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Dump Device Attributes"/>
                                <Label DockPanel.Dock="Left" Content="Device filter:" VerticalAlignment="Center"/>
                                <TextBox x:Name="tbDumpDeviceFilter" ToolTip="Dumps device attribute trees + GSD PrmData to AttributeDumps\ (paths in csv syntax). Device name filter: regex, case-insensitive, empty = all devices."/>
                            </DockPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- splitter between the tabs and the log -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#FFD8D8DE" Margin="6,1,6,1"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

        <!-- ==================== Log (toolbar + view) ==================== -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="dpLogToolbar" Grid.Row="0" Margin="6,2,6,2">
                <Label DockPanel.Dock="Left" Content="Log" FontWeight="SemiBold"/>
                <Button x:Name="btnLogPopout" Click="btnLogPopout_Click" DockPanel.Dock="Left" Margin="6,0,0,0" MinWidth="0" Padding="8,0" Content="Pop out &#x2197;"
                        ToolTip="Open the log in its own window (this one keeps running too)"/>
                <Button x:Name="btnClearLogs" Click="btnClearLogs_Click" DockPanel.Dock="Right" MinWidth="80" Background="#FFADFFF9" Content="Clear Logs"/>
                <Button x:Name="btnCancelOperation" Click="btnCancelOperation_Click" DockPanel.Dock="Right" Margin="0,0,8,0" MinWidth="120" FontWeight="SemiBold" Background="#FFFFD2D2" Visibility="Hidden" Content="Cancel Operation"/>
                <CheckBox x:Name="cbLogToFile" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="Normal" Content="Log to file" Checked="cbLogToFile_Checked" Unchecked="cbLogToFile_Unchecked"/>
                <TextBox x:Name="tbLogFilter" Margin="8,0,12,0" FontWeight="Normal" TextChanged="tbLogFilter_TextChanged"
                         ToolTip="Filter shown log lines (regex, case-insensitive). Invalid pattern = show all (box turns red)."/>
            </DockPanel>

            <ListView x:Name="lbLogView" x:FieldModifier="public" Grid.Row="1" Margin="4,0,4,4"
                      FontSize="11" FontFamily="Consolas" SelectionMode="Extended"
                      BorderThickness="1" BorderBrush="#FF0015C7"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      KeyDown="lbLogView_KeyDown">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy selected" InputGestureText="Ctrl+C" Click="miCopyLogSelected_Click"/>
                        <MenuItem Header="Copy all" Click="miCopyLogAll_Click"/>
                        <Separator/>
                        <MenuItem Header="Clear" Click="btnClearLogs_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <!-- Method Running Spinner (overlays the log view) -->
            <fa:ImageAwesome x:Name="icoRunning" Panel.ZIndex="2" Visibility="Hidden" Icon="Refresh" Spin="True" Grid.Row="1" Height="48" Width="48" SpinDuration="10" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF0015C7"/>
        </Grid>
    </Grid>

</Window>
