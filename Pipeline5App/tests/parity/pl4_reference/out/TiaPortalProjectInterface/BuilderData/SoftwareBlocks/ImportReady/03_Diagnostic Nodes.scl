    "PROFINET_NODES_ALARM"."n0031-sm72-xns1 192.168.50.31" := "10_PN_NETWORK".SUBNET_50[31];
	END_REGION

	REGION Subnet 51 192.168.51.xxx
    "PROFINET_NODES_WARNING"."n0010-mc2-cc1-k66001 192.168.51.10" := "10_PN_NETWORK".SUBNET_51[10];
    "PROFINET_NODES_ALARM"."n0005-ms2-cc1-k65001 192.168.51.5" := "10_PN_NETWORK".SUBNET_51[5];
