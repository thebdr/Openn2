<Window x:Class="Openn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:local="clr-namespace:Openn"
        mc:Ignorable="d"
        
        Title="Openn2"
        
        MinHeight="400" 
        Height="450"
        
        MinWidth="750" 
        Width="800"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Activated="Window_Activated"
        >
    <Window.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="Black" Offset="0"/>
            <GradientStop Color="White" Offset="1"/>
            <GradientStop Color="#FFCFCFCF" Offset="0"/>
            <GradientStop Color="#E6E0E0E0" Offset="0.5"/>            
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="3,5,3,3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Open Project /-->
        <Button x:Name="btnAttachProject" Click="btnAttachProject_Click" Grid.Row="0" Grid.Column="0" Margin="2,2,2,2">
            <AccessText Text="Attach to Project in Tia Portal" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <Button x:Name="btnBrowseProjects" Click="btnBrowseProjects_Click" Grid.Row="0" Grid.Column="2" Margin="2,2,4,2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="80" Height="20">
            <AccessText Text="Browse Folder.." TextWrapping="Wrap" TextAlignment="Center" FontSize="10"/>
        </Button>
        <Button x:Name="btnDetachProject" Click="btnDetachProject_Click" Grid.Row="0" Grid.Column="6" Margin="2,2,4,2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="40" Height="20">
            <AccessText Text="Detach" TextWrapping="Wrap" TextAlignment="Center" FontSize="10"/>
        </Button>
        <RadioButton x:Name="rbUsePath" GroupName="rbgProjectSource" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,7,5,2" FontSize="11">Attach by path</RadioButton>
        <RadioButton x:Name="rbUseInstance" GroupName="rbgProjectSource" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,7,5,2" FontSize="11">Attach to open instance</RadioButton>
        <TextBox x:Name="tbProjectPath" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="20" Margin="5,2,2,5" FontSize="10"/>
        <ComboBox x:Name="cbOpenTiaInstances" Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="20" Margin="5,2,2,5" FontSize="10" Background="White"></ComboBox>
        <TextBox x:Name="tbAttachedProject" Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="20" Margin="5,2,2,5" FontSize="11" IsReadOnly ="True" Background="#E6E6E6"/>
        <Label Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2" Content="Attached Project:" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,1,5,2" FontSize="10"/>
        
        <!-- Search & Export PLC Program Blocks (opens the regex search window) /-->
        <Button x:Name="btnExportSource" Click="btnExportSource_Click" Grid.Row="1" Grid.Column="0" Margin="2,2,2,2">
            <AccessText Text="Search / Export Blocks.." TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="Opens a search window over all program blocks (regex, includes subfolders)" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,1,5,2" FontSize="9"/>

        <!-- Import Source Code to PLC Block /-->
        <Button x:Name="btnImportSource" Click="btnImportSource_Click" Grid.Row="2" Grid.Column="0" Margin="2,2,2,2">
            <AccessText Text="Import Block from Source" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <Button x:Name="btnBrowseBlocks" Click="btnBrowseBlocks_Click" Grid.Row="2" Grid.Column="2" Margin="2,2,4,2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="80" Height="20">
            <AccessText Text="Browse File.." TextWrapping="Wrap" TextAlignment="Center" FontSize="10"/>
        </Button>
        <Label Grid.Row="2" Grid.Column="1" Content="Source File Path:" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,1,5,2" FontSize="9"/>
        <TextBox x:Name="tbSourceBlockPath" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="20" Margin="5,2,2,5" FontSize="10"/>

        <!-- Hardware Configuration explorer/editor (tree + regex search over the csv data) /-->
        <Button x:Name="btnEditHardwareConfig" Click="btnEditHardwareConfig_Click" Grid.Row="2" Grid.Column="3" Margin="2,2,2,2">
            <AccessText Text="Edit Hardware Config.." TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>

        <!-- Import Hardware Configuration from .CSV /-->
        <Button x:Name="btnImportHardwareCsv" Click="btnImportHardwareCsv_Click" Grid.Row="3" Grid.Column="0" Margin="2,2,2,2">
            <AccessText Text="Import Hardware Config from .Csv" TextWrapping="Wrap" TextAlignment="Center" />
        </Button>
        <Button x:Name="btnBrowseHwConfigCsv" Click="btnBrowseHwConfigCsv_Click" Grid.Row="3" Grid.Column="2" Margin="2,2,4,2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="80" Height="20">
            <AccessText Text="Browse Folder.." TextWrapping="Wrap" TextAlignment="Center" FontSize="10"/>
        </Button>
        <Label Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Content="Hardware Configuration .Csv Folder Path:" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,1,5,2" FontSize="9"/>
        <TextBox x:Name="tbHardwareCsvPath" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="20" Margin="5,2,2,5" FontSize="10"/>

        <!-- Generate Hardware /-->
        <Button x:Name="btnGenerateHardware" Click="btnGenerateHardware_Click" Grid.Row="3" Grid.Column="3" Margin="2,2,2,2">
            <AccessText Text="Generate Hardware" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <RadioButton x:Name="rbUseExistingIoControllers" GroupName="rbgIoControllerSource" Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,9,1,2" FontSize="11" FontFamily="Consolas">Use Existing I/O Controllers</RadioButton>
        <RadioButton x:Name="rbCreateNewIoControllers" GroupName="rbgIoControllerSource" Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="2,2,1,9" FontSize="11" FontFamily="Consolas">Create New I/O Controllers</RadioButton>

        <!--Method Running Spinner -->
        
        
        <!-- Cancels the running backend operation (visible only while one runs) /-->
        <Button x:Name="btnCancelOperation" Click="btnCancelOperation_Click" Grid.Row="6" Grid.Column="5" Margin="2,2,4,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="110" Height="25" FontWeight="SemiBold" Background="#FFFFD2D2" Visibility="Hidden">
            <AccessText Text="Cancel Operation" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" />
        </Button>

        <!-- TextView for logs & messages /-->
        <Button x:Name="btnClearLogs" Click="btnClearLogs_Click" Grid.Row="6" Grid.Column="6" Margin="2,2,4,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="80" Height="25" FontFamily="Courrier New" FontWeight="SemiBold" FontStyle="Italic"  Background="#FFADFFF9">
            <AccessText Text="Clear Logs" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" />
        </Button>

        <ListView x:Name="lbLogView" x:FieldModifier="public" FontSize="11" Grid.Row="7" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="8" BorderThickness="2" BorderBrush="#FF0015C7" 
            ScrollViewer.HorizontalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        </ListView>
        
        <!-- Method Running Spinner  -->
        <fa:ImageAwesome x:Name="icoRunning" Panel.ZIndex="2" Visibility="Hidden" Icon="Refresh" Spin="True" Grid.Row="7" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="8" Height="48" Width="48" SpinDuration="10" Margin="5,5,5,5" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

</Window>
