  <!--
    Compile-time reference to Siemens.Engineering.dll (supported range: V18 - V20).
    The first existing location wins. Order: repo-local 'lib' override (for machines
    without TIA Portal), then the oldest installed TIA Portal version (V18 first) for
    maximum runtime compatibility. The version actually loaded at runtime is selected
    by the user at startup and resolved in 03_ApiManager\OpennessSetup.cs - the dll is
    never copied to the output folder (Private=False).
  -->
  <PropertyGroup>
    <_SiemensRegDll18>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Siemens\Automation\Openness\18.0\PublicAPI\18.0', 'Siemens.Engineering', null, RegistryView.Registry64))</_SiemensRegDll18>
    <_SiemensRegDll19>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Siemens\Automation\Openness\19.0\PublicAPI\19.0', 'Siemens.Engineering', null, RegistryView.Registry64))</_SiemensRegDll19>
    <_SiemensRegDll20>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Siemens\Automation\Openness\20.0\PublicAPI\20.0', 'Siemens.Engineering', null, RegistryView.Registry64))</_SiemensRegDll20>
    <SiemensEngineeringDll Condition="Exists('$(MSBuildProjectDirectory)\lib\Siemens.Engineering.dll')">$(MSBuildProjectDirectory)\lib\Siemens.Engineering.dll</SiemensEngineeringDll>
    <SiemensEngineeringDll Condition="'$(SiemensEngineeringDll)' == '' And '$(_SiemensRegDll18)' != '' And Exists('$(_SiemensRegDll18)')">$(_SiemensRegDll18)</SiemensEngineeringDll>
    <SiemensEngineeringDll Condition="'$(SiemensEngineeringDll)' == '' And '$(_SiemensRegDll19)' != '' And Exists('$(_SiemensRegDll19)')">$(_SiemensRegDll19)</SiemensEngineeringDll>
    <SiemensEngineeringDll Condition="'$(SiemensEngineeringDll)' == '' And '$(_SiemensRegDll20)' != '' And Exists('$(_SiemensRegDll20)')">$(_SiemensRegDll20)</SiemensEngineeringDll>
    <SiemensEngineeringDll Condition="'$(SiemensEngineeringDll)' == '' And Exists('C:\Program Files\Siemens\Automation\Portal V18\PublicAPI\V18\Siemens.Engineering.dll')">C:\Program Files\Siemens\Automation\Portal V18\PublicAPI\V18\Siemens.Engineering.dll</SiemensEngineeringDll>
    <SiemensEngineeringDll Condition="'$(SiemensEngineeringDll)' == '' And Exists('C:\Program Files\Siemens\Automation\Portal V19\PublicAPI\V19\Siemens.Engineering.dll')">C:\Program Files\Siemens\Automation\Portal V19\PublicAPI\V19\Siemens.Engineering.dll</SiemensEngineeringDll>
    <SiemensEngineeringDll Condition="'$(SiemensEngineeringDll)' == '' And Exists('C:\Program Files\Siemens\Automation\Portal V20\PublicAPI\V20\Siemens.Engineering.dll')">C:\Program Files\Siemens\Automation\Portal V20\PublicAPI\V20\Siemens.Engineering.dll</SiemensEngineeringDll>
  </PropertyGroup>
